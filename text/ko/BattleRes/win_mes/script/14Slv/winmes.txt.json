[[39,[[1,10,"흥, 승리는 당연하다"]]],[43,[[1,8,"자랑해도 좋다."]]],[44,[[2,6,"푸른 마녀"],[7,13,"와 맞서고도"]]],[45,[[1,13,"아직 숨이 붙어 있으니까."]]],[49,[[1,5,"시시하군"],[7,8,"."]]],[50,[[1,18,"네놈이 나를 이길 요소는 하나도 없다."]]],[54,[[1,14,"이 승리를 전하께 바칩니다."]]],[58,[[1,16,"네가 죽는 것도, 내가 죽는 것도"]]],[59,[[1,11,"모두 전하를 위해서다."]]],[63,[[1,11,"처음 보는 복장이지만"]]],[64,[[1,14,"갈리아 사람이 아니었나"]]],[68,[[1,10,"지금부터 귀환한다."]]],[69,[[1,14,"뒤처리는 맡기겠다, 칼."]]],[73,[[1,6,"투항해라."]]],[74,[[1,16,"목숨만은 살려 두겠다."]]],[78,[[1,3,"큭"],[5,12," 예거 녀석,"]]],[79,[[1,16,"내게 이런 잡무를 떠넘기다니"],[18,19,"."]]],[80,[[1,4,"칼"],[6,17,"바로 전하 곁으로 돌아간다"]]],[96,[[1,19,"호오, 네놈도 꽤 하는군."]]],[97,[[1,4,"어떠냐"],[6,21,"내 밑에서 일해 볼 생각은 있나"]]],[102,[[1,25,"잘했다, 상으로 내가 요리를 만들어 주마."]]],[103,[[1,22,"좋아하는 걸 말해라, 뭐든 만들어 주지."]]],[111,[[3,4,"."]]],[115,[[3,4,"."]]],[119,[[3,4,"."]]],[123,[[3,4,"."]]],[127,[[3,4,"."]]],[131,[[3,4,"."]]],[135,[[3,4,"."]]],[139,[[3,4,"."]]],[143,[[3,4,"."]]]]