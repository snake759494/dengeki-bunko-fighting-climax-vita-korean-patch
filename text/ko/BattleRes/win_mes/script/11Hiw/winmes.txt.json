[[39,[[1,16,"이자야보다는 훨씬 마음에 들었다."]]],[40,[[1,15,"그러니까 이걸로 봐주지."]]],[44,[[1,10,"나는"],[11,21,"폭력이 싫다. 그건 거짓말이 아니야."]]],[48,[[1,13,"나는 더 강해지고 싶어."]]],[49,[[1,18,"내 분노를 억누를 수 있을 만큼 강하게."]]],[53,[[1,23,"나도 처음부터 이랬던 건 아니라고."]]],[57,[[1,13,"죽여죽여죽여죽여죽여죽여"],[14,15,"."]]],[61,[[1,21,"나는 이 힘이 싫어서 싫어서 견딜 수 없었다."]]],[62,[[1,16,"나를 받아들여 줄 녀석 따윈"]]],[63,[[1,15,"아무도 없다고 생각해서."]]],[67,[[1,3,"좋아"],[4,7,"죽인다."],[8,13,"꼭 죽인다."]]],[68,[[1,7,"확실하게"],[8,15,"죽인다. 활활 죽인다."]]],[72,[[1,10,"이제 됐지."]]],[73,[[1,20,"나는 내 존재를 인정해도 되는 거지."]]],[74,[[1,18,"나 자신을 좋아해도 되는 거지."]]],[78,[[1,25,"잠깐 신주쿠 가서 이자야 놈을 죽여 버리고 오지."]]],[82,[[1,5,"아야야"],[7,12," 저 녀석"]]],[83,[[1,16,"이케부쿠로에서도 통할 실력이야."]]],[84,[[1,17,"여자로 두기 아까울 정도군."]]],[88,[[1,14,"좋아, 백발백중의"]]],[89,[[1,17,"슛 테크닉을 익혀 주마"]]],[90,[[1,11,"이자야아, 기다려라"]]],[106,[[1,14,"너, 내가 무섭지 않냐"]]],[111,[[1,17,"너도 꽤 하잖아."]]],[118,[[1,14,"폭력은 싫다고 했는데"],[16,17,"."]]],[119,[[1,17,"되받아쳐 버렸잖아."]]],[120,[[1,14,"정당방위니까 봐줘라"]]],[124,[[2,4,"절무"],[5,8," 씨여"],[10,11,"."]]],[125,[[1,19,"변신할 거면 더 센 녀석으로 해."]]],[126,[[1,14,"공룡으로라도 변해 보지 그래"]]],[130,[[1,17,"방금 승부는 꽤 힘들었군"],[19,20,"."]]],[131,[[1,18,"뭐, 정정당당한 결투라면"]]],[132,[[1,14,"그렇게 싫지도 않지만."]]],[136,[[1,10,"남의 힘을 이용해서"]]],[137,[[1,16,"강해져 봤자 허무할 뿐이잖아"],[18,19,"."]]],[138,[[1,14,"뭐가 즐거운 거냐, 진짜로."]]],[142,[[1,10,"이 수 저 수 바꿔 가며"]]],[143,[[1,16,"질리지도 않고 싸움을 거는군"],[18,19,"."]]],[144,[[1,15,"뭐 지루하지 않아서 좋지만."]]],[148,[[1,12,"절망이니 뭐니 어려운 말로"]]],[149,[[1,13,"다 아는 듯이 지껄이는군"],[15,16,"."]]],[150,[[1,21,"그런 녀석이 제일 짜증 난다고, 나는."]]],[154,[[1,17,"절망이란 것도 모르는 건 아니야."]]],[155,[[1,20,"하지만 그런 거랑 타협하는 게"]]],[156,[[1,14,"강하다는 거 아니냐"]]],[160,[[1,12,"아아, 젠장. 이것도 전부"]]],[161,[[1,13,"그 벼룩 자식 짓은"]]],[162,[[1,7,"아니겠지"]]],[166,[[1,13,"꽤 강했다, 절무"],[15,16,"."]]],[167,[[1,17,"너하고는 절망이니 꿈이니 다 빼고"]]],[168,[[1,17,"한 번 더 싸워 보고 싶군."]]]]