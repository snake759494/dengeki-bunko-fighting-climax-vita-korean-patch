[[39,[[1,7,"내 승리네."]]],[40,[[1,19,"후후, 무슨 말이든 다 들어야 해."]]],[44,[[1,19,"정말 지루할 틈이 없다니까, 이 도시는"],[21,22,"."]]],[48,[[1,5,"정말"],[7,8,"."]]],[49,[[1,23,"왜 내가 이렇게 지쳐야 하냐고～."]]],[53,[[1,16,"눈앞에 허들이 놓이면"]]],[54,[[1,21,"그걸 뛰어넘지 않고는 못 배기는 성격이라"]]],[55,[[1,6,"미안해."]]],[59,[[1,4,"어때"],[6,16,"뭐 이 정도야."]]],[63,[[1,11,"봐주긴 했어."]]],[67,[[3,4,"."]]],[68,[[1,20,"너, 나한테 무슨 캐릭터를 기대하는 거야"]]],[72,[[1,17,"정말, 그 바보 어디 있는 거야."]]],[76,[[1,8,"나한테는"],[9,23,", 미사카 미코토라는 이름이 있거든"]]],[77,[[1,12,"적당히 좀 외워 이 바보야"]]],[82,[[1,3,"어때"],[5,11,"내 전격은."]]],[83,[[1,16,"게임 세계와는 차원이 다르지"]]],[88,[[1,3,"좋아"],[5,9," 내 승리"]]],[89,[[1,13,"앞으로는 자판기를"]]],[90,[[1,10,"소중히 하라고"]]],[106,[[1,9,"지금까지 전전전승"]]],[111,[[1,21,"따, 딱히 네가 도와주지 않아도"]]],[112,[[1,17,"내 힘이면 어떻게든 됐거든."]]],[119,[[1,19,"조, 조금 지나쳤을지도 모르지만"]]],[120,[[1,19,"싸움을 걸어온 건 그쪽이니까."]]],[121,[[1,10,"나쁘게 생각하지 마."]]],[124,[[2,4,"절무"],[5,6,"라"],[8,9,""]]],[125,[[1,16,"정말 음험하고 재수 없는 녀석."]]],[126,[[1,16,"뭘 노리고 이런 짓을 하는 거야"]]],[130,[[2,12,"돌아갈 방법은"]]],[131,[[3,13,"생각해 봐야 소용없나"]]],[135,[[1,21,"너와 싸운 사람들의 마음을 짊어지고 있으니까"]]],[136,[[1,13,"절대로 질 수 없어."]]],[137,[[1,3,"이"],[5,9," 나는 말이야."]]],[141,[[1,9,"만만찮은 상대가 많아"],[11,12,"."]]],[142,[[1,13,"더 이상 몰리면"]]],[143,[[1,14,"봐주지 못하게 될 것 같아"],[16,17,"."]]],[147,[[2,3,"꿈"],[4,18,"이 절망을 낳기도 한다니"],[20,21,"."]]],[148,[[1,4,"그런"],[6,11," 거짓말이지"],[13,14,""]]],[152,[[1,11,"지금은 싸우는 수밖에"],[13,14,"."]]],[153,[[1,9,"나아가기 위해서."]]],[157,[[2,7,"최후의 희망"],[8,10,"이라니"],[12,13,"."]]],[158,[[1,19,"힘들지만 불타는 시추에이션이네"]]],[159,[[1,5,"이 싸움"],[7,16," 절대로 질 수 없어"]]],[163,[[1,10,"나아가려는 뜨거운 마음"],[12,13,"."]]],[164,[[1,21,"그게 없는 너한테는 질 것 같지 않아."]]],[165,[[1,10,"내 승리야, 절무."]]]]