[[39,[[1,15,"그런 각오로 살아남을 만큼"]]],[40,[[1,17,"브레인 버스트는 만만하지 않다."]]],[41,[[1,22,"왜 졌는지 하룻밤 천천히 생각해 보도록."]]],[45,[[1,17,"음, 꽤 괜찮은 손맛이었다."]]],[46,[[1,8,"굿 게임."]]],[50,[[1,23,"강함이란 승리만을 뜻하는 것이 아니란다."]]],[51,[[1,21,"내가 그걸 깨달았을 때는 이미 너무 늦었지만"],[23,24,"."]]],[55,[[1,16,"이 정도 싸움에서 져서는"]]],[56,[[1,15,"흑의 왕이라 칭할 수 없겠지."]]],[60,[[1,19,"동료와 함께 겨루고 서로 지탱함으로써"]]],[61,[[1,13,"모든 가능성이 펼쳐진다."]]],[64,[[1,17,"걸어 봐라, 그 무한한 가능성에."]]],[68,[[1,13,"너는 더 할 수 있을 터다."]]],[69,[[1,3,"일어서라"],[5,13,"한계를 넘어라"]]],[73,[[1,6,"더 앞으로"]]],[74,[[2,4,"가속"],[5,12,"하고 싶지 않나"]]],[79,[[1,19,"하루유키 군은 지금쯤 무엇을 하고 있을까"],[21,22,"."]]],[83,[[1,14,"우리 버스트 링커는"]]],[84,[[1,4,"의식을 "],[8,20,"배의"],[21,21,"속도로 가속한다."]]],[85,[[1,19,"너희로서는 내게 닿는 것조차 불가능하지."]]],[94,[[1,8,"굿 게임."]]],[95,[[1,24,"일렉트로마스터의 힘, 만끽하게 해 줬군."]]],[96,[[1,11,"또 한 판 부탁하지."]]],[101,[[1,13,"소드 아트 온라인"]]],[102,[[1,17,"실로 재미있어 보이는 게임 아닌가."]]],[103,[[1,20,"그래, 하루유키 군에게도 알려 줘야겠군."]]],[119,[[1,9,"대단하지 않나"]]],[120,[[3,19,"고맙다, 너를 고르길 잘했어."]]],[125,[[1,14,"내 눈에 틀림은 없었군."]]],[126,[[1,21,"너는 이제 순색의 칠왕에게도 뒤지지 않아."]]],[133,[[1,11,"사태가 파악되지 않지만"],[13,14,"."]]],[134,[[1,11,"계속 이기다 보면"]]],[135,[[1,17,"무언가 보일지도 모르겠군."]]],[138,[[1,14,"전투 중에 아바타 체인지를"]]],[139,[[1,10,"할 수 있는 적 "],[11,13,"절무"],[16,17,"."]]],[140,[[1,9,"녀석의 목적은 뭐지"]]],[144,[[1,8,"굿 게임."]]],[145,[[1,10,"꽤 좋은 실력이지만"]]],[146,[[1,15,"아직 잡념이 많은 모양이군."]]],[150,[[1,8,"그 정도로는"]]],[151,[[1,15,"나를 붙잡을 수 없다."]]],[152,[[1,16,"너의 진심을 더 보여 다오."]]],[156,[[2,12,"돌아갈 방법은"]]],[157,[[1,4,"으음"],[6,15," 전혀 모르겠군"]]],[161,[[1,3,"꿈이"],[5,11," 절망을 부른다."]]],[162,[[1,15,"이해 못 할 바는 아니다. 하지만"]]],[163,[[1,9,"좀 석연찮군"]]],[167,[[1,14,"이렇게까지 고전하게 될 줄이야"]]],[168,[[1,13,"이 세계 특유의 시스템이"]]],[169,[[1,15,"싸움에 영향을 주는 걸까"],[17,18,"."]]],[173,[[1,16,"절망이 핵인 힘은 약하고 무르다"]]],[174,[[1,18,"나를, 아니 누구도 쓰러뜨릴 수 없다."]]],[175,[[1,15,"어째서 그걸 모르는 거냐, 절무."]]],[178,[[1,11,"꿈을 이루든, 깨지든"]]],[179,[[1,18,"자신의 의지와 힘만이 그것을 이끈다."]]],[180,[[1,3,"절무"],[5,16," 이 승부, 나의 승리다."]]]]