[[20,[[4,6,"절무"]]],[22,[[0,13,"흥, 역시 그저 범인인가"],[15,16,"."]]],[23,[[0,19,"신불이나 마신이라도 부를 줄 알았더니,"]]],[24,[[0,9,"맥이 빠지는군."]]],[38,[[4,7,"흑설공주"]]],[40,[[0,1,"응"],[3,4,"?"]]],[61,[[4,6,"미사카"],[7,9,"미코토"]]],[63,[[0,10,"너희가 어떤 꿈을"]]],[64,[[0,17,"품고 있는지 알 바 아니야."]]],[65,[[0,17,"어차피 전부 산산조각 날 테니까!!"]]],[69,[[4,7,"흑설공주"]]],[71,[[2,9,"그 말투라면,"]]],[72,[[0,21,"나 말고도 여기 다이브한 자가 있는 모양이군"],[23,24,"."]]],[76,[[4,6,"미사카"],[7,9,"미코토"]]],[78,[[0,15,"그딴 건, 진작 반격해 버렸지."]]],[79,[[0,17,"그 녀석들 세계째로 내 디너로."]]],[80,[[0,19,"희망과 꿈의 담당자란 게 이 정도야."]]],[84,[[4,6,"미사카"],[7,9,"미코토"]]],[86,[[0,13,"너는 전신들의 발악으로"]]],[87,[[0,15,"불려 나와 휘말린 것뿐."]]],[88,[[0,12,"나한테는 디저트지."]]],[92,[[4,7,"흑설공주"]]],[94,[[0,2,"호오"],[4,5,"."]]],[95,[[0,20,"아바타 체인지의 이유는 그런 건가."]]],[99,[[4,7,"흑설공주"]]],[101,[[0,23,"아까 에너미인지 여신인지가 말한 대로,"]]],[102,[[0,8,"너는 쓰러뜨린 자의 "],[9,11,"정보"],[12,21,"를 흡수하는군."]]],[106,[[4,6,"미사카"],[7,9,"미코토"]]],[108,[[0,8,"꿈은 무력해."]]],[109,[[0,18,"피투성이 폭력에 짓밟힐 뿐."]]],[110,[[0,13,"너한테도 가르쳐 줄게!"]]],[114,[[4,7,"흑설공주"]]],[116,[[0,3,"흠."]]],[117,[[0,22,"나도 꿈이니 희망이니 하는 말은 서툴지만,"]]],[118,[[0,17,"싸우겠다면 상대해 주지. 와라!"]]]]