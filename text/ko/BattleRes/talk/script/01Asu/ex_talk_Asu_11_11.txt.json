[[19,[[4,7,"아스나"]]],[21,[[0,3,"어머?"]]],[22,[[0,15,"오늘은 라이더 슈트 입은 분은"]]],[23,[[0,11,"같이 안 왔어요?"]]],[27,[[4,7,"헤이와지마"],[8,10,"시즈오"]]],[29,[[0,9,"셀티 말이냐?"]]],[30,[[0,18,"딱히 늘 같이 다니는 건 아니야."]]],[34,[[4,7,"아스나"]]],[36,[[0,19,"후후, 그래도 꽤 사이 좋아 보였는데요?"]]],[40,[[4,7,"아스나"]]],[42,[[0,6,"아, 맞다."]]],[43,[[0,12,"저, 셀티 씨에 대해"]]],[44,[[0,15,"여쭤보고 싶은 게 있어요."]]],[48,[[4,7,"아스나"]]],[50,[[0,12,"그분, 제가 말을 걸어도"]]],[51,[[0,22,"늘 필담으로만 대답하는데,"]]],[52,[[0,9,"왜 그럴까요?"]]],[56,[[4,7,"아스나"]]],[58,[[0,14,"혹시 미움받는 걸까"],[16,17,"?"]]],[62,[[4,7,"헤이와지마"],[8,10,"시즈오"]]],[64,[[0,6,"아마 아냐."]]],[65,[[0,16,"그 녀석도 사정이 있겠지."]]],[69,[[4,7,"아스나"]]],[71,[[0,3,"사정?"]]],[75,[[4,7,"헤이와지마"],[8,10,"시즈오"]]],[77,[[0,8,"비밀로 해라?"]]],[78,[[0,16,"실은 그 녀석은 목 위가 없는데"],[18,19,"."]]],[82,[[4,7,"아스나"]]],[84,[[0,3,"네엣"],[5,17,"! 가, 갑자기 무서운 얘기로"]]],[85,[[0,16,"이쪽을 동요시키는 작전인가요!?"]]],[86,[[0,13,"그, 그런 수엔 안 넘어가요!"]]]]