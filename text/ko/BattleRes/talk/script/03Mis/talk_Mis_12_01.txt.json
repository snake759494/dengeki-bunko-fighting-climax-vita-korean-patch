[[32,[[4,6,"절무"]]],[34,[[0,2,"윽"],[4,5,"."]]],[35,[[0,6,"이, 이 힘은"],[8,9,"."]]],[39,[[4,6,"미사카"],[7,9,"미코토"]]],[41,[[0,8,"이걸로 끝이야."]]],[42,[[0,11,"결판은, 알잖아."]]],[46,[[4,6,"절무"]]],[48,[[0,3,"네놈은"],[5,11,"꼭두각시일 뿐"],[13,14,"!"]]],[49,[[0,20,"전신에게 소환되고, 남에게 꿈을 떠맡고,"]]],[50,[[0,8,"어째서 싸우는가!"]]],[54,[[4,6,"미사카"],[7,9,"미코토"]]],[56,[[0,20,"딱히 떠맡겨지기'만' 하는 건 아니야."]]],[57,[[0,18,"그게 등을 떠미는 형태로, 내 무언가가"]]],[58,[[0,14,"변하고 있는 건지도 몰라."]]],[62,[[4,6,"미사카"],[7,9,"미코토"]]],[64,[[0,17,"토키와다이의 아가씨? 일곱 능력자? "]]],[65,[[0,18,"그것도, 정말로 나만의 힘으로 잡은"]]],[66,[[0,10,"건지는 모르겠어."]]],[70,[[4,6,"미사카"],[7,9,"미코토"]]],[72,[[0,18,"난 분명, 꿈에게서 뭔가를 받고 있어."]]],[73,[[0,23,"그럼, 꿈을 위해 뭔가를 해도 틀리지 않아!!"]]],[77,[[4,6,"절무"]]],[79,[[0,8,"꿈엔 힘이 없다."]]],[80,[[0,15,"그렇게 보이는 게 절망의 시작."]]],[81,[[0,12,"넌 아무것도 못 이뤄!"]]],[85,[[4,6,"미사카"],[7,9,"미코토"]]],[87,[[0,17,"이뤄지냐 마냐는 문제가 아니야!!"]]],[88,[[0,18,"닿지 못한 꿈이 다음 노력으로 이어질"]]],[89,[[0,9,"일도 있다고!"]]],[93,[[4,6,"절무"]]],[95,[[0,11,"더 논쟁해도 무의미한가"],[13,14,"."]]],[96,[[0,3,"승부다"],[5,14,"결판을 내 주마!"]]],[107,[[4,6,"미사카"],[7,9,"미코토"]]],[109,[[0,18,"만약, 내가 등을 떠밀린 것처럼,"]]],[110,[[0,16,"나를 보고 나아가고 싶은 사람이"]]],[111,[[0,8,"한 명이라도 있다면"],[10,11,""]]],[115,[[4,6,"미사카"],[7,9,"미코토"]]],[117,[[0,14,"함께 가자. 우리의 힘으로!!"]]],[132,[[4,6,"절무"]]],[134,[[0,6,"나는 '절무'"],[8,9,"."]]],[135,[[0,15,"모든 꿈을 끊고, 온갖 희망을"]]],[136,[[0,12,"무로 돌리기 위해 태어났다"],[14,15,"."]]],[149,[[4,6,"전신"]]],[151,[[0,2,"크윽"],[4,5,"!"]]],[152,[[0,3,"절무에게"],[5,10,"삼켜"],[12,14,"진다!"]]],[180,[[4,9,"셀베리아"]]],[182,[[0,14,"범부라 얕본 무례를 사과하마."]]],[183,[[0,13,"그리고, 인정해 주지 않겠나"],[15,16,"."]]],[184,[[0,15,"네놈이 나의 불구대천 원수라고!"]]],[188,[[4,9,"셀베리아"]]],[190,[[0,12,"전신에게 뺏은 모든 힘으로"],[14,15,"."]]],[191,[[0,5,"네놈이라는 "],[6,8,"희망"],[9,10,"을"],[13,14,"꿈"],[15,17,"을,"]]],[192,[[0,14,"전부 먹어 치워 주마!!"]]]]