[[19,[[4,6,"미사카"],[7,9,"미코토"]]],[21,[[0,15,"아, 그 고양이 같은 인형,"]]],[22,[[0,7,"이름이 뭐야?"]]],[23,[[0,13,"엄청 귀엽잖아."]]],[27,[[4,6,"히메라기"],[7,9,"유키나"]]],[29,[[0,13,"이건 '네코마탕'이에요."]]],[30,[[0,12,"전 학교에서 인기였던"]]],[31,[[0,14,"마스코트 캐릭터예요."]]],[35,[[4,6,"히메라기"],[7,9,"유키나"]]],[37,[[0,13,"이런 걸 들고 다니는 건,"]]],[38,[[0,19,"좀 어린애 같을지도 모르지만요."]]],[42,[[4,6,"미사카"],[7,9,"미코토"]]],[44,[[0,11,"그렇지 않아～."]]],[45,[[0,12,"사실 나도 이런 걸 모으는"],[14,15,"."]]],[49,[[4,6,"히메라기"],[7,9,"유키나"]]],[51,[[0,17,"아, 그 개구리 마스코트 굿즈는"]]],[52,[[0,10,"기념품 같은 건가요?"]]],[56,[[4,6,"미사카"],[7,9,"미코토"]]],[58,[[2,5,"어?"]]],[62,[[4,6,"히메라기"],[7,9,"유키나"]]],[64,[[0,14,"얼마 전 초등학생쯤 되는 애가"]]],[65,[[0,20,"비슷한 걸 갖고 있는 걸 봤어요."]]],[69,[[4,6,"미사카"],[7,9,"미코토"]]],[71,[[0,9,"그그그, 그래!"]]],[72,[[0,15,"주변에 이런 거 좋아하는 애가"]]],[73,[[0,6,"있어서 말이야"],[8,9,"."]]],[77,[[4,6,"히메라기"],[7,9,"유키나"]]],[79,[[0,14,"귀엽긴 하지만, 역시,"]]],[80,[[0,19,"직접 쓰는 건 좀 부끄러워요."]]],[84,[[4,6,"미사카"],[7,9,"미코토"]]],[86,[[0,8,"그, 그렇지～!"]]],[87,[[0,10,"아하, 아하하하～!!"]]]]