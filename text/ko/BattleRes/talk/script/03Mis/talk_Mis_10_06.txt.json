[[23,[[4,6,"절무"]]],[25,[[0,3,"말도 안 돼"],[5,12,"안 쓰러지다니"],[13,15,""]]],[26,[[0,11,"조금 너무 놀았나"],[13,14,"?"]]],[30,[[4,6,"미사카"],[7,9,"미코토"]]],[32,[[0,16,"어떻게 보일지 모르겠지만,"]]],[33,[[0,20,"나도 지겹도록 수라장을 헤쳐 왔다고."]]],[54,[[4,7,"키리토"]]],[56,[[0,14,"그렇군. 전신 놈들이 마지막에"]]],[57,[[0,18,"소환했을 만은 하다는 거군."]]],[61,[[4,7,"키리토"]]],[63,[[0,13,"너도 너의 꿈을 위해"]]],[64,[[0,12,"이 세계에 온 거지?"]]],[65,[[0,20,"전신에게 속고 있는 줄도 모르고, 말이야."]]],[71,[[4,6,"미사카"],[7,9,"미코토"]]],[73,[[0,12,"남이 시켜야 돕는"]]],[74,[[0,11,"그런 녀석으로 보여?"]]],[75,[[0,3,"내가."]]],[81,[[4,7,"키리토"]]],[83,[[0,10,"생각해 본 적 있어?"]]],[84,[[0,17,"너희의 꿈이란 건, 누군가의 절망과"]]],[85,[[0,16,"표리일체라는 사실에 대해."]]],[89,[[4,7,"키리토"]]],[91,[[0,10,"누가 꿈을 이룰 때,"]]],[92,[[0,19,"동시에 다른 누군가는 꿈을 빼앗겨."]]],[93,[[0,15,"세계의 리소스는 유한하니까."]]],[97,[[4,7,"키리토"]]],[99,[[0,16,"꿈이니 희망이니 하는 게 있으니,"]]],[100,[[0,17,"같은 만큼 절망도 생겨나 버리지."]]],[104,[[4,6,"미사카"],[7,9,"미코토"]]],[106,[[0,1,"무슨"],[3,9,"소리야"],[11,12,"."]]],[107,[[0,13,"꿈을 가져서 절망한다니."]]],[108,[[0,8,"그런, 그런 건"],[10,11,"."]]],[112,[[4,7,"키리토"]]],[114,[[0,12,"난, 그 절망의 화신이야."]]],[115,[[0,19,"너희가 만든 어둠의 무게와 날카로움을,"]]],[116,[[0,14,"그 몸으로 맛보도록 해."]]]]