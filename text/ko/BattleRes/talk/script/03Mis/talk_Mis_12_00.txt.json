[[30,[[4,6,"절무"]]],[32,[[0,2,"윽"],[4,5,"."]]],[33,[[0,6,"이, 이 힘은"],[8,9,"."]]],[37,[[4,6,"미사카"],[7,9,"미코토"]]],[39,[[0,8,"이걸로 끝이야."]]],[40,[[0,11,"결판은, 알잖아."]]],[44,[[4,6,"절무"]]],[46,[[0,3,"네놈은"],[5,11,"꼭두각시일 뿐"],[13,14,"!"]]],[47,[[0,20,"전신에게 소환되고, 남에게 꿈을 떠맡고,"]]],[48,[[0,8,"어째서 싸우는가!"]]],[52,[[4,6,"미사카"],[7,9,"미코토"]]],[54,[[0,20,"딱히 떠맡겨지기'만' 하는 건 아니야."]]],[55,[[0,18,"그게 등을 떠미는 형태로, 내 무언가가"]]],[56,[[0,14,"변하고 있는 건지도 몰라."]]],[60,[[4,6,"미사카"],[7,9,"미코토"]]],[62,[[0,17,"토키와다이의 아가씨? 일곱 능력자? "]]],[63,[[0,18,"그것도, 정말로 나만의 힘으로 잡은"]]],[64,[[0,10,"건지는 모르겠어."]]],[68,[[4,6,"미사카"],[7,9,"미코토"]]],[70,[[0,18,"난 분명, 꿈에게서 뭔가를 받고 있어."]]],[71,[[0,23,"그럼, 꿈을 위해 뭔가를 해도 틀리지 않아!!"]]],[75,[[4,6,"절무"]]],[77,[[0,8,"꿈엔 힘이 없다."]]],[78,[[0,15,"그렇게 보이는 게 절망의 시작."]]],[79,[[0,12,"넌 아무것도 못 이뤄!"]]],[83,[[4,6,"미사카"],[7,9,"미코토"]]],[85,[[0,17,"이뤄지냐 마냐는 문제가 아니야!!"]]],[86,[[0,18,"닿지 못한 꿈이 다음 노력으로 이어질"]]],[87,[[0,9,"일도 있다고!"]]],[91,[[4,6,"절무"]]],[93,[[0,11,"더 논쟁해도 무의미한가"],[13,14,"."]]],[94,[[0,3,"승부다"],[5,14,"결판을 내 주마!"]]],[105,[[4,6,"미사카"],[7,9,"미코토"]]],[107,[[0,18,"만약, 내가 등을 떠밀린 것처럼,"]]],[108,[[0,16,"나를 보고 나아가고 싶은 사람이"]]],[109,[[0,8,"한 명이라도 있다면"],[10,11,""]]],[113,[[4,6,"미사카"],[7,9,"미코토"]]],[115,[[0,14,"함께 가자. 우리의 힘으로!!"]]],[130,[[4,6,"절무"]]],[132,[[0,6,"나는 '절무'"],[8,9,"."]]],[133,[[0,15,"모든 꿈을 끊고, 온갖 희망을"]]],[134,[[0,12,"무로 돌리기 위해 태어났다"],[14,15,"."]]],[147,[[4,6,"전신"]]],[149,[[0,2,"크윽"],[4,5,"!"]]],[150,[[0,3,"절무에게"],[5,10,"삼켜"],[12,14,"진다!"]]],[178,[[4,7,"아키라"]]],[180,[[0,14,"범부라 얕본 무례를 사과하마."]]],[181,[[0,13,"그리고, 인정해 주지 않겠나"],[15,16,"."]]],[182,[[0,15,"네놈이 나의 불구대천 원수라고!"]]],[186,[[4,7,"아키라"]]],[188,[[0,12,"전신에게 뺏은 모든 힘으로"],[14,15,"."]]],[189,[[0,5,"네놈이라는 "],[6,8,"희망"],[9,10,"을"],[13,14,"꿈"],[15,17,"을,"]]],[190,[[0,15,"전부 먹어 치워 주마!!"]]]]