[[23,[[4,6,"절무"]]],[25,[[0,3,"설마"],[5,12,"아직 버티다니"],[14,15,"."]]],[26,[[0,11,"조금 너무 놀았나"],[13,14,"?"]]],[30,[[4,6,"시바"],[7,9,"미유키"]]],[32,[[0,8,"유감이네."]]],[33,[[0,23,"난 이런 곳에서 죽을 수는 없거든."]]],[54,[[4,7,"키리토"]]],[56,[[0,14,"그렇군. 전신들이 마지막으로"]]],[57,[[0,18,"소환한 보람은 있다는 거네."]]],[61,[[4,7,"키리토"]]],[63,[[0,13,"너도 너의 꿈을 위해"]]],[64,[[0,12,"이 세계에 온 거지?"]]],[65,[[0,20,"전신에게 넘어간 줄도 모르고, 말이야."]]],[71,[[4,6,"시바"],[7,9,"미유키"]]],[73,[[0,6,"어리석긴"],[8,9,"."]]],[74,[[0,14,"난 오라버니 외엔 누구에게도"]]],[75,[[0,13,"넘어가지 않아."]]],[81,[[4,7,"키리토"]]],[83,[[0,10,"생각해 본 적 있어?"]]],[84,[[0,17,"너희 꿈이라는 건, 누군가의 절망과"]]],[85,[[0,16,"표리일체라는 사실에 대해서."]]],[89,[[4,7,"키리토"]]],[91,[[0,10,"누가 꿈을 이룰 때,"]]],[92,[[0,19,"동시에 다른 누군가는 꿈을 뺏기는 거야."]]],[93,[[0,15,"세계의 리소스는 유한하니까."]]],[97,[[4,7,"키리토"]]],[99,[[0,16,"꿈이니 희망이니 하는 게 있어서,"]]],[100,[[0,17,"같은 만큼 절망도 생겨나는 거야."]]],[104,[[4,6,"시바"],[7,9,"미유키"]]],[106,[[0,13,"그래, 사실은 알고 있어."]]],[107,[[0,13,"내 꿈은 결코 이뤄지지 않아"],[15,16,"."]]],[108,[[0,6,"이것이, 절망"],[8,9,"?"]]],[112,[[4,7,"키리토"]]],[114,[[0,12,"난, 그 절망의 화신이야."]]],[115,[[0,19,"너희가 만든 어둠의 무게와 날카로움을,"]]],[116,[[0,14,"그 몸으로 맛봐라."]]]]