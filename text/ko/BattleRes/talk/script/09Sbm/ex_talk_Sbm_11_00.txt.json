[[19,[[4,6,"시바"],[7,9,"미유키"]]],[21,[[0,6,"그만한 힘"],[8,15,"얻기까지"]]],[22,[[0,15,"대체 얼마나 수련을 거듭했을지,"]]],[23,[[0,9,"상상도 안 가네요."]]],[27,[[4,7,"샤나"]]],[29,[[0,9,"난 태어났을 때부터"]]],[30,[[0,16,"알라스토르의 계약자가 되기 위해"]]],[31,[[0,9,"수행을 쌓아 왔어."]]],[35,[[4,7,"샤나"]]],[37,[[0,15,"모든 건, 플레임헤이즈로서"]]],[38,[[0,7,"세상의 적 "],[8,12,"홍세의 무리"],[13,14,"를"]]],[39,[[0,7,"토멸하기 위해."]]],[43,[[4,7,"샤나"]]],[45,[[0,13,"난 그렇게 되려고 태어났고,"]]],[46,[[0,13,"그렇게 살아갈 거야."]]],[50,[[4,6,"시바"],[7,9,"미유키"]]],[52,[[0,11,"자신이 태어난 이유를,"]]],[53,[[0,16,"그렇게 쉽게 단정 짓지 않아도"]]],[54,[[0,11,"되지 않을까요?"]]],[58,[[4,6,"시바"],[7,9,"미유키"]]],[60,[[0,11,"세상에는 자신의 출신에"]]],[61,[[0,10,"얽매이길 싫어하고,"]]],[62,[[0,19,"그에 맞서려 필사적인 사람들도 있어요."]]],[66,[[4,6,"시바"],[7,9,"미유키"]]],[68,[[0,16,"당신의 인생은 당신 자신의 것."]]],[69,[[0,21,"그 삶의 방식도, 본래 자유로워야 할 거예요."]]],[73,[[4,7,"샤나"]]],[75,[[2,19,"그 '맞서는 사람들'이라는 게,"]]],[76,[[0,11,"네 가까이에 있나 보네."]]],[80,[[4,7,"샤나"]]],[82,[[0,13,"어쩌면, 너 자신도."]]],[83,[[0,20,"하지만 난 남이 날 멈추게 할 생각은 없어."]]],[84,[[0,19,"네가 말한 자유의 결과가 지금의 나니까."]]],[88,[[4,7,"샤나"]]],[90,[[0,15,"너도, 자신에게 지워진 사명에"]]],[91,[[0,19,"맞서겠다면, 그 각오를 힘으로 삼아,"]]],[92,[[0,11,"나한테 보여 봐!"]]]]