[[19,[[4,5,"미나토"],[6,8,"토모카"]]],[21,[[0,14,"미유키 씨, 마법을 쓰다니"]]],[22,[[0,6,"대단해요!"]]],[26,[[4,6,"시바"],[7,9,"미유키"]]],[28,[[0,10,"후후, 고마워."]]],[29,[[0,17,"토모카는 만약 마법을 쓸 수 있다면"]]],[30,[[0,16,"어떤 걸 해 보고 싶어?"]]],[34,[[4,5,"미나토"],[6,8,"토모카"]]],[36,[[0,7,"네? 저요"],[9,10,"?"]]],[37,[[0,11,"으음, 그러니까요."]]],[41,[[4,5,"미나토"],[6,8,"토모카"]]],[43,[[0,10,"빨리 크고 싶다"],[12,15,"든지?"]]],[44,[[0,4,"키라든가"],[6,18,"그, 그 밖에도 되면."]]],[48,[[4,5,"미나토"],[6,8,"토모카"]]],[50,[[0,16,"미, 미유키 씨 같은 멋진 여성이"]]],[51,[[0,7,"되고 싶어서요!"]]],[55,[[4,6,"시바"],[7,9,"미유키"]]],[57,[[0,2,"그래"],[4,17,". 그건 정말 기쁘네."]]],[58,[[0,15,"하지만 아쉽게도, 마법이라 해도"]]],[59,[[0,13,"그렇게까지 만능은 아니야."]]],[63,[[4,6,"시바"],[7,9,"미유키"]]],[65,[[0,16,"현 기술로는 마법으로 사람 성장을"]]],[66,[[0,13,"촉진하거나 성장의 방향성을"]]],[67,[[0,16,"조절할 수는 없거든."]]],[71,[[4,5,"미나토"],[6,8,"토모카"]]],[73,[[2,8,"그렇군요."]]],[77,[[4,6,"시바"],[7,9,"미유키"]]],[79,[[0,15,"하지만 토모카라면 마법 같은 건"]]],[80,[[0,13,"쓰지 않아도, 분명 멋진"]]],[81,[[0,13,"여성이 될 수 있을 거야."]]],[85,[[4,5,"미나토"],[6,8,"토모카"]]],[87,[[2,5,"네!"]]],[88,[[0,7,"힘낼게요!"]]]]