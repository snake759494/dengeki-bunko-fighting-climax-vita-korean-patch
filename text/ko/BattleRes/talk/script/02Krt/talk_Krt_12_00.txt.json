[[30,[[4,6,"절무"]]],[32,[[0,2,"윽"],[4,5,"."]]],[33,[[0,6,"이, 이 힘은"],[8,9,"."]]],[37,[[4,7,"키리토"]]],[39,[[0,16,"절무, 넌 이제 나를 이길 수 없어."]]],[43,[[4,6,"절무"]]],[45,[[0,3,"네놈은"],[5,11,"꼭두각시일 뿐"],[13,14,"!"]]],[46,[[0,20,"전신에게 소환되고, 남에게 꿈을 떠맡고,"]]],[47,[[0,8,"어째서 싸우는가!"]]],[51,[[4,7,"키리토"]]],[53,[[0,19,"확실히 희망은 절망의 이면일지도 몰라."]]],[54,[[0,21,"하지만, 그건 둘 다 자기 안에 있는 거야."]]],[58,[[4,7,"키리토"]]],[60,[[0,14,"검을 내던지고 주저앉는 것도,"]]],[61,[[0,15,"이를 악물고 계속 싸우는 것도,"]]],[62,[[0,8,"선택은 자신이야."]]],[66,[[4,7,"키리토"]]],[68,[[0,14,"그러니 꿈은 이뤄진다고 믿고"]]],[69,[[0,11,"한 걸음씩 나아가는 것."]]],[70,[[0,11,"중요한 건 그것뿐이야."]]],[74,[[4,6,"절무"]]],[76,[[0,12,"가능성은 빼앗는 것이다!"]]],[77,[[0,9,"승리자는 단 한 명,"]]],[78,[[0,20,"그 외 인간의 꿈 따윈 모두 무가치하다!!"]]],[82,[[4,7,"키리토"]]],[84,[[0,11,"못 이룰 꿈이라도,"]]],[85,[[0,19,"그 안에는 무한한 가능성이 존재해!"]]],[89,[[4,6,"절무"]]],[91,[[0,16,"그렇다면, 네 희망이 내 절망보다"]]],[92,[[0,18,"크다는 걸 증명해 보아라!!"]]],[103,[[4,7,"키리토"]]],[105,[[0,23,"네가 지금까지 먹어 온 플레이어들의 희망은,"]]],[106,[[0,8,"아직 안 사라졌어"],[10,11,"."]]],[110,[[4,7,"키리토"]]],[112,[[0,13,"그게, 내 검의 힘이 된다!"]]],[127,[[4,6,"절무"]]],[129,[[0,6,"나는 '절무'"],[8,9,"."]]],[130,[[0,15,"모든 꿈을 끊고, 온갖 희망을"]]],[131,[[0,12,"무로 돌리기 위해 태어났다"],[14,15,"."]]],[144,[[4,6,"전신"]]],[146,[[0,2,"크윽"],[4,5,"!"]]],[147,[[0,3,"절무에게"],[5,10,"삼켜"],[12,14,"진다!"]]],[175,[[4,7,"아키라"]]],[177,[[0,14,"범부라 얕본 무례를 사과하마."]]],[178,[[0,13,"그리고, 인정해 주지 않겠나"],[15,16,"."]]],[179,[[0,15,"네놈이 나의 불구대천 원수라고!"]]],[183,[[4,7,"아키라"]]],[185,[[0,12,"전신에게 뺏은 모든 힘으로"],[14,15,"."]]],[186,[[0,5,"네놈이라는 "],[6,8,"희망"],[9,10,"을"],[13,14,"꿈"],[15,17,"을,"]]],[187,[[0,15,"전부 먹어 치워 주마!!"]]]]