[[20,[[4,6,"절무"]]],[22,[[0,13,"흥, 역시 그저 범부인가"],[15,16,"."]]],[23,[[0,19,"신불이나 마신이라도 부를 줄 알았더니,"]]],[24,[[0,9,"참 맥 빠지는군."]]],[38,[[4,7,"키리토"]]],[40,[[0,2,"뭐"],[4,5,"?"]]],[61,[[4,6,"코사카"],[7,9,"키리노"]]],[63,[[0,18,"너희들 꿈 따윈 관심 없다니까."]]],[64,[[0,18,"어차피 전부 없어져 버릴 거니까."]]],[68,[[4,7,"키리토"]]],[70,[[2,17,"그 말투로 보면, 나 말고도"]]],[71,[[0,21,"이 세계로 컨버트해 온 녀석이 있는 거야?"]]],[75,[[4,6,"코사카"],[7,9,"키리노"]]],[77,[[0,17,"전신들이 불러낸 녀석들은"]]],[78,[[0,10,"이제 없다니까."]]],[79,[[0,16,"내가 세계째로 먹어 버렸어."]]],[83,[[4,6,"코사카"],[7,9,"키리노"]]],[85,[[0,3,"즉"],[5,6,"."]]],[86,[[0,11,"네가 마지막이란 거."]]],[90,[[4,7,"키리토"]]],[92,[[0,6,"그렇군."]]],[93,[[0,20,"아바타가 계속 바뀌는 건 그래서였나"],[22,23,"."]]],[97,[[4,7,"키리토"]]],[99,[[0,17,"아까 그 여신님이 말한 대로,"]]],[100,[[0,17,"넌 쓰러뜨린 플레이어의 데이터를"]]],[101,[[0,13,"통째로 복사하고 있구나."]]],[105,[[4,6,"코사카"],[7,9,"키리노"]]],[107,[[0,22,"어떤 꿈이든, 이뤄지지 않으면 의미 없잖아."]]],[108,[[0,13,"자, 너도 절망해 버려."]]],[112,[[4,7,"키리토"]]],[114,[[0,19,"그런 말 듣고 순순히 리자인할 만큼"]]],[115,[[0,10,"순진하진 않아서."]]],[116,[[0,19,"나도 조금은 발버둥 쳐 보실까."]]]]