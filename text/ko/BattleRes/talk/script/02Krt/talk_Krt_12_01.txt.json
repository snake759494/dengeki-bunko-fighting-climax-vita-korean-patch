[[32,[[4,6,"절무"]]],[34,[[0,2,"윽"],[4,5,"."]]],[35,[[0,6,"이, 이 힘은"],[8,9,"."]]],[39,[[4,7,"키리토"]]],[41,[[0,16,"절무, 넌 이제 나를 이길 수 없어."]]],[45,[[4,6,"절무"]]],[47,[[0,3,"네놈은"],[5,11,"꼭두각시일 뿐"],[13,14,"!"]]],[48,[[0,20,"전신에게 소환되고, 남에게 꿈을 떠맡고,"]]],[49,[[0,8,"어째서 싸우는가!"]]],[53,[[4,7,"키리토"]]],[55,[[0,19,"확실히 희망은 절망의 이면일지도 몰라."]]],[56,[[0,21,"하지만, 그건 둘 다 자기 안에 있는 거야."]]],[60,[[4,7,"키리토"]]],[62,[[0,14,"검을 내던지고 주저앉는 것도,"]]],[63,[[0,15,"이를 악물고 계속 싸우는 것도,"]]],[64,[[0,8,"선택은 자신이야."]]],[68,[[4,7,"키리토"]]],[70,[[0,14,"그러니 꿈은 이뤄진다고 믿고"]]],[71,[[0,11,"한 걸음씩 나아가는 것."]]],[72,[[0,11,"중요한 건 그것뿐이야."]]],[76,[[4,6,"절무"]]],[78,[[0,12,"가능성은 빼앗는 것이다!"]]],[79,[[0,9,"승리자는 단 한 명,"]]],[80,[[0,20,"그 외 인간의 꿈 따윈 모두 무가치하다!!"]]],[84,[[4,7,"키리토"]]],[86,[[0,11,"못 이룰 꿈이라도,"]]],[87,[[0,19,"그 안에는 무한한 가능성이 존재해!"]]],[91,[[4,6,"절무"]]],[93,[[0,16,"그렇다면, 네 희망이 내 절망보다"]]],[94,[[0,18,"크다는 걸 증명해 보아라!!"]]],[105,[[4,7,"키리토"]]],[107,[[0,23,"네가 지금까지 먹어 온 플레이어들의 희망은,"]]],[108,[[0,8,"아직 안 사라졌어"],[10,11,"."]]],[112,[[4,7,"키리토"]]],[114,[[0,13,"그게, 내 검의 힘이 된다!"]]],[129,[[4,6,"절무"]]],[131,[[0,6,"나는 '절무'"],[8,9,"."]]],[132,[[0,15,"모든 꿈을 끊고, 온갖 희망을"]]],[133,[[0,12,"무로 돌리기 위해 태어났다"],[14,15,"."]]],[146,[[4,6,"전신"]]],[148,[[0,2,"크윽"],[4,5,"!"]]],[149,[[0,3,"절무에게"],[5,10,"삼켜"],[12,14,"진다!"]]],[177,[[4,9,"셀베리아"]]],[179,[[0,14,"범부라 얕본 무례를 사과하마."]]],[180,[[0,13,"그리고, 인정해 주지 않겠나"],[15,16,"."]]],[181,[[0,15,"네놈이 나의 불구대천 원수라고!"]]],[185,[[4,9,"셀베리아"]]],[187,[[0,12,"전신에게 뺏은 모든 힘으로"],[14,15,"."]]],[188,[[0,5,"네놈이라는 "],[6,8,"희망"],[9,10,"을"],[13,14,"꿈"],[15,17,"을,"]]],[189,[[0,14,"전부 먹어 치워 주마!!"]]]]