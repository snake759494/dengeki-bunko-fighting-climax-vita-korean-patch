[[19,[[4,7,"샤나"]]],[21,[[0,20,"플레임헤이즈는 언제나 '둘이서 하나'."]]],[22,[[0,16,"길드인지 뭔지 모르겠지만,"]]],[23,[[0,20,"무리 짓는 게 전제인 싸움은 이해 못 해."]]],[27,[[4,7,"아스나"]]],[29,[[0,17,"나, 너 같은 사람 알아."]]],[33,[[4,7,"아스나"]]],[35,[[0,15,"좀 강하다고 아무 데나"]]],[36,[[0,10,"혼자 나가 버리고"],[12,13,"."]]],[40,[[4,7,"아스나"]]],[42,[[0,15,"게다가 툭하면 위험한 일을"]]],[43,[[0,17,"당하면서도 전혀 반성을 안 해서"],[19,20,"."]]],[47,[[4,7,"아스나"]]],[49,[[0,19,"이쪽이 얼마나 걱정하는지는"]]],[50,[[0,12,"하나도 모르는 거야!"]]],[51,[[0,7,"그런 사람이야."]]],[55,[[4,7,"아스나"]]],[57,[[0,11,"너도 분명 누군가에게"]]],[58,[[0,15,"걱정만 끼치고 있지?"]]],[59,[[0,10,"조금은 반성하렴!"]]],[63,[[4,7,"샤나"]]],[65,[[0,15,"시, 시끄러시끄러시끄러!"]]],[66,[[0,12,"내가 누굴 걱정시키든"]]],[67,[[0,16,"그런 건 너랑 상관없잖아!"]]],[71,[[4,7,"아스나"]]],[73,[[0,8,"그런데 안됐네."]]],[74,[[0,14,"나, 그런 사람 길들이는 데엔"]]],[75,[[0,10,"자신이 있거든."]]],[79,[[4,7,"아스나"]]],[81,[[0,5,"일단은"],[7,8,"."]]],[85,[[4,7,"아스나"]]],[87,[[0,18,"이 싸움이 끝나면 점심 먹자?"]]],[88,[[0,16,"아주 맛있는 바게트 샌드를"]]],[89,[[0,10,"대접해 줄게!"]]]]